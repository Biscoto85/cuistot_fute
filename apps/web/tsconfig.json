{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    // "bundler" permet les imports sans extension et est le mode recommandé par Vite.
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "outDir": "dist",
    "paths": {
      // @cuistot/shared résolu via node_modules (symlink pnpm → packages/shared/dist)
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
