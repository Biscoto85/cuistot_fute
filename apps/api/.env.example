# Environnement (development | production)
NODE_ENV=development

# Port de l'API Express (3003 en dev, cohérent avec PairsForm=3001 / Partiprism=3002)
PORT=3003

# PostgreSQL — base dédiée à cuistot (séparée de PairsForm et Partiprism)
DATABASE_URL=postgresql://cuistot:changeme@localhost:5432/cuistot

# JWT — secret long (≥32 chars), généré avec : openssl rand -base64 48
JWT_SECRET=changeme-generate-with-openssl-rand-base64-48

# Anthropic — clé API pour la génération de plans
ANTHROPIC_API_KEY=sk-ant-...

# CORS — origins autorisées (frontend dev + prod)
CORS_ORIGIN=http://localhost:5174
